# BirdNET server config — copy to .env and fill in.

# Optional: enables Claude narrative on /enrich. Falls back to wikipedia if absent.
# Reads from ~/clawd/.env by default if not set here.
ANTHROPIC_API_KEY=

# Optional: enables eBird "common here?" regional cross-check.
# Free key: https://ebird.org/api/keygen
EBIRD_API_KEY=

# Default minimum BirdNET confidence (0-1). Lower = more hits, more noise.
BIRDNET_MIN_CONFIDENCE=0.15
