      "primary_source_url": "https://ojibwe.lib.umn.edu/",
      "source_credit": "A project of the Department of American Indian Studies, University of Minnesota, in partnership with Anishinaabe speakers and the Minnesota Historical Society."
    },
    "mohawk": {
      "endonym": "Kanien'kéha",
      "english_name": "Mohawk / Kanien'kéha",
      "nations": "Kanien'kehá:ka (People of the Flint) — Haudenosaunee / Six Nations. Traditional territory spans the St. Lawrence valley and southern Ontario, including Tyendinaga, Akwesasne, Kahnawà:ke, Kanehsatà:ke, and the Six Nations of the Grand River.",
      "primary_source": "Onkwawenna Kentyohkwa and Kanien'kehá:ka Onkwawén:na Raotitiókwa Language and Cultural Center references",
      "primary_source_url": "https://kanienkeha.net/",
      "source_credit": "Verified entries will be added as community-led dictionary sources are integrated."
    },
    "cree": {
      "endonym": "ᓀᐦᐃᔭᐍᐏᐣ / nēhiyawēwin (Plains Cree) and ililīmowin (Moose / Swampy Cree)",
      "english_name": "Cree",
      "nations": "Mushkegowuk (Swampy Cree) — northern Ontario coast of James Bay & Hudson Bay; Moose Cree at Moose Factory; Plains Cree to the west.",
      "primary_source": "Online Cree Dictionary / itwêwina; Cree Literacy Network",
      "primary_source_url": "https://itwewina.altlab.app/",
      "source_credit": "Verified entries will be added as community-led dictionary sources are integrated."
    }
